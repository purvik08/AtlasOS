# ============================================================
# Atlas OS — pi-gen build configuration
# ============================================================
# Run from ~/pi-gen after symlinking this file:
#   ln -sf ~/AtlasOS/image/config ~/pi-gen/config
#   sudo bash build.sh

IMG_NAME="AtlasOS"
RELEASE="bookworm"
DEPLOY_COMPRESSION="xz"
DEPLOY_ZIP=0

# Default user (created by stage2 baseline, then customised by stage-atlas)
FIRST_USER_NAME="atlas"
FIRST_USER_PASS="atlas123"
DISABLE_FIRST_BOOT_USER_RENAME=1

# Locale / keyboard / timezone  — change TZ to your zone
LOCALE_DEFAULT="en_GB.UTF-8"
KEYBOARD_KEYMAP="gb"
KEYBOARD_LAYOUT="English (UK)"
TIMEZONE_DEFAULT="Asia/Kolkata"

# SSH enabled so models can be scp'd onto the device after flashing
ENABLE_SSH=1

# Skip the full desktop stages — we only need stage2 (minimal Debian)
# plus our own stage-atlas on top.
STAGE_LIST="stage0 stage1 stage2 stage-atlas"

# Target: Raspberry Pi 5
TARGET_HOSTNAME="atlas-os"
